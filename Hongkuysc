    if newName == "" then
        newName = "Preset " .. tostring(#appData.presets + 1)
    end
    if newRemote == "" then
        newRemote = "RI3aUNDuH2"
    end

    local cleanS1 = normalizeByteString(buf1Box.Text)
    local cleanS2 = normalizeByteString(buf2Box.Text)
    local useS2 = settingUseS2 and (cleanS2 ~= "")

    local newPreset = {
        name = newName,
        remote = newRemote,
        dur1 = duration1Input.Text,
        dur2 = duration2Input.Text,
        speed = speedInput.Text,
        bufDelay = bufDelayInput.Text,
        useScript2 = useS2,
        slots = {
            { s1 = cleanS1, s2 = cleanS2 },
            { s1 = cleanS1, s2 = cleanS2 },
            { s1 = cleanS1, s2 = cleanS2 }
