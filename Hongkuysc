local function saveConfigData()
    pcall(function()
        if writefile then
            local json = HttpService:JSONEncode(appData)
            writefile(CONFIG_FILE, json)
        end
    end)
end

local function loadConfigData()
    local loaded = false
    pcall(function()
        if isfile and readfile and isfile(CONFIG_FILE) then
            local raw = readfile(CONFIG_FILE)
            local decoded = HttpService:JSONDecode(raw)
            if type(decoded) == "table" and type(decoded.presets) == "table" and #decoded.presets > 0 then
                for k, v in pairs(decoded) do
                    appData[k] = v
                end
                if appData.moveCycleEnabled == nil then
                    appData.moveCycleEnabled = true
                end
                appData.dropDelay = tostring(appData.dropDelay or "5")
                appData.dropRemote = tostring(appData.dropRemote or "wDXRlfJPK1")
                appData.dropBufStr = tostring(appData.dropBufStr or defaultDropBytes)
                appData.dropKeybind = tostring(appData.dropKeybind or "None")

                appData.collectRadius = tostring(appData.collectRadius or "25")
                appData.collectSpeed = tostring(appData.collectSpeed or "0.05")
                appData.collectRemote = tostring(appData.collectRemote or "")
                appData.collectBufStr = tostring(appData.collectBufStr or "")
                appData.collectKeybind = tostring(appData.collectKeybind or "None")

                for _, p in ipairs(appData.presets) do
                    p.remote = p.remote or "RI3aUNDuH2"
                    p.dur1 = tostring(p.dur1 or "0")
                    p.dur2 = tostring(p.dur2 or "0.04")
                    p.speed = tostring(p.speed or "0.03")
                    p.bufDelay = tostring(p.bufDelay or "0")
                    if p.useScript2 == nil then
                        p.useScript2 = true
                    end
                    if type(p.slots) ~= "table" then p.slots = {} end
                    for s = 1, 3 do
                        if type(p.slots[s]) ~= "table" then
                            p.slots[s] = { s1 = defaultS1, s2 = defaultS2 }
                        else
                            p.slots[s].s1 = tostring(p.slots[s].s1 or "")
                            p.slots[s].s2 = tostring(p.slots[s].s2 or "")
                        end
                    end
                end
                if not appData.presets[appData.selectedPreset] then
                    appData.selectedPreset = 1
                end
                if appData.selectedSlot < 1 or appData.selectedSlot > 3 then
                    appData.selectedSlot = 1
                end
                loaded = true
            end
        end
    end)
    return loaded
end

