local notifToken = 0

local function sendSystemNotification(titleText, bodyText, playJoinSound)
    notifToken = notifToken + 1
    local currentToken = notifToken

    gtTitleLabel.Text = ">> " .. string.upper(titleText) .. " <<"
    gtBodyLabel.Text = bodyText

    gtTitleLabel.TextTransparency = 0
    gtBodyLabel.TextTransparency = 0
    gtTitleStroke.Transparency = 0
    gtBodyStroke.Transparency = 0

    gtNotifHolder.Position = UDim2.new(0.5, 0, 0.19, 0)
    gtNotifHolder.Visible = true

    TweenService:Create(
        gtNotifHolder,
        TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Position = UDim2.new(0.5, 0, 0.22, 0) }
    ):Play()

    task.delay(3.5, function()
        if notifToken ~= currentToken then return end
        local fadeInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(gtTitleLabel, fadeInfo, { TextTransparency = 1 }):Play()
        TweenService:Create(gtBodyLabel, fadeInfo, { TextTransparency = 1 }):Play()
        TweenService:Create(gtTitleStroke, fadeInfo, { Transparency = 1 }):Play()
        TweenService:Create(gtBodyStroke, fadeInfo, { Transparency = 1 }):Play()
        task.wait(0.5)
        if notifToken == currentToken then
            gtNotifHolder.Visible = false
        end
    end)

    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channels = TextChatService:FindFirstChild("TextChannels")
            local sysChannel = channels and (channels:FindFirstChild("RBXSystem") or channels:FindFirstChild("RBXGeneral"))
            if sysChannel then
                sysChannel:DisplaySystemMessage('<font color="#55ffff">[' .. titleText .. ']: ' .. bodyText .. '</font>')
            end
        else
            StarterGui:SetCore("ChatMakeSystemMessage", {
                Text = "[" .. titleText .. "]: " .. bodyText,
                Color = Color3.fromRGB(85, 255, 255),
                Font = Enum.Font.GothamBold
            })
        end
    end)

    if playJoinSound then
        local sound = Instance.new("Sound")
        sound.SoundId = JOIN_SOUND_ID
        sound.Volume = 1.5
        sound.Parent = SoundService
        sound:Play()
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
        task.delay(10, function()
            if sound and sound.Parent then
                sound:Destroy()
            end
        end)
    end
end

