-- ==========================================
-- 8. MAIN SPAM LOOP, AUTO-MOVE, AUTO DROP & AUTO COLLECT (2D & 3D SUPPORT)
-- ==========================================
local isSpamming = false
local isDropping = false
local isCollecting = false
local isCurrentlyMoving = false

local function updateStatusDisplay()
    local spamStr
    if isCurrentlyMoving then
        spamStr = '<font color="#ffdf55">MOV</font>'
    else
        spamStr = isSpamming and '<font color="#65e874">ON</font>' or '<font color="#ff6b6b">OFF</font>'
    end
    local dropStr = isDropping and '<font color="#65e874">ON</font>' or '<font color="#ff6b6b">OFF</font>'
    local colStr = isCollecting and '<font color="#65e874">ON</font>' or '<font color="#ff6b6b">OFF</font>'
    statusTopRight.Text = "S: " .. spamStr .. " | D: " .. dropStr .. " | C: " .. colStr
end

local function interruptibleWait(seconds)
    local startWait = os.clock()
    while isSpamming and (os.clock() - startWait) < seconds do
        task.wait(0.05)
    end
end

local function executeMoveBreakSequence()
    local holdATime  = tonumber(holdAInput.Text) or 0.3
    local waitAfterA = tonumber(waitAfterAInput.Text) or 2
    local holdWTime  = tonumber(holdWInput.Text) or 0.3
    local holdDTime  = tonumber(holdDInput.Text) or 0.3

    if holdATime < 0.01 then holdATime = 0.01 end
    if waitAfterA < 0 then waitAfterA = 0 end
    if holdWTime < 0.01 then holdWTime = 0.01 end
    if holdDTime < 0.01 then holdDTime = 0.01 end

    isCurrentlyMoving = true
    updateStatusDisplay()

    -- 1. Tahan A selama 0.3 detik
    cycleStatusLabel.Text = 'Cycle Status: <font color="#ffdf55">1. Holding [A] (' .. holdATime .. 's)...</font>'
    pressAndHoldKey(Enum.KeyCode.A, holdATime)
    if not isSpamming then isCurrentlyMoving = false; updateStatusDisplay(); return end

    -- 2. Tunggu selama 2 detik
    if waitAfterA > 0 then
        cycleStatusLabel.Text = 'Cycle Status: <font color="#ffdf55">2. Waiting (' .. waitAfterA .. 's)...</font>'
        interruptibleWait(waitAfterA)
        if not isSpamming then isCurrentlyMoving = false; updateStatusDisplay(); return end
    end

    -- 3. Langsung tahan W selama 0.3 detik
    cycleStatusLabel.Text = 'Cycle Status: <font color="#ffdf55">3. Holding [W] (' .. holdWTime .. 's)...</font>'
    pressAndHoldKey(Enum.KeyCode.W, holdWTime)
    if not isSpamming then isCurrentlyMoving = false; updateStatusDisplay(); return end

    -- 4. Tahan D selama 0.3 detik
    cycleStatusLabel.Text = 'Cycle Status: <font color="#ffdf55">4. Holding [D] (' .. holdDTime .. 's)...</font>'
    pressAndHoldKey(Enum.KeyCode.D, holdDTime)

    isCurrentlyMoving = false
    updateStatusDisplay()
end

-- Deteksi apakah sebuah BasePart adalah Drop Item (Gems, Seed, Block, atau item kecil di dekat karakter)
local DROP_KEYWORDS = {
    "drop", "gem", "seed", "coin", "item", "orb", "loot", "crystal", "diamond", "pickup", "collect", "floating"
}

local function isPartOfAnyPlayer(obj, myCharModel)
    if myCharModel and obj:IsDescendantOf(myCharModel) then
        return true
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and obj:IsDescendantOf(plr.Character) then
            return true
        end
        local pName = string.lower(plr.Name)
        local dName = string.lower(plr.DisplayName)
        local parent = obj.Parent
        while parent and parent ~= workspace do
            local parName = string.lower(parent.Name)
            if parName == pName or parName == dName then
                return true
            end
            parent = parent.Parent
        end
    end
    return false
end

local function isLikelyDroppedItem(part, myCharModel)
    if not part or not part:IsA("BasePart") then return false end
    if part == workspace.Terrain or part.Locked then return false end
    if isPartOfAnyPlayer(part, myCharModel) then return false end

    -- Abaikan blok bangunan / tile tanah yang ukurannya penuh (>= 4.2 studs) kecuali di dalam folder Drop
    local isInsideDropFolder = false
    local parent = part.Parent
    while parent and parent ~= workspace do
        local pName = string.lower(parent.Name)
        for _, kw in ipairs(DROP_KEYWORDS) do
            if string.find(pName, kw, 1, true) then
                isInsideDropFolder = true
                break
            end
        end
        if isInsideDropFolder then break end
        parent = parent.Parent
    end

    if isInsideDropFolder then
        return true
    end

    -- Jika ukurannya terlalu besar (seperti blok background atau lantai), abaikan
    if part.Size.X > 3.8 and part.Size.Y > 3.8 then
        return false
    end

    -- Cek TouchTransmitter
    if part:FindFirstChildOfClass("TouchTransmitter") then
        return true
    end

    -- Cek nama part
    local partName = string.lower(part.Name)
    for _, kw in ipairs(DROP_KEYWORDS) do
        if string.find(partName, kw, 1, true) then
            return true
        end
    end

    -- Di game 2D seperti ini, drop item (seed/gems) biasanya berupa part kecil (< 3.2 studs) dengan Texture/Decal/SurfaceGui/BillboardGui/Mesh
    if part.Size.Magnitude < 4.5 then
        if part:FindFirstChildOfClass("Decal")
            or part:FindFirstChildOfClass("Texture")
            or part:FindFirstChildOfClass("BillboardGui")
            or part:FindFirstChildOfClass("SurfaceGui")
            or part:FindFirstChildOfClass("SpecialMesh")
            or part:IsA("MeshPart") then
            return true
        end
    end

    return false
end

local function collectSingleItem(part, rootPart, myCharModel)
    pcall(function()
        -- 1. Tarik part drop ke posisi karakter
        part.CanCollide = false
        part.CFrame = rootPart.CFrame

        -- 2. Jika part tergabung dalam Model kecil (misal Model Drop), pindahkan juga PrimaryPart/Model-nya
        if part.Parent and part.Parent:IsA("Model") and part.Parent ~= workspace and part.Parent ~= myCharModel then
            part.Parent:PivotTo(rootPart.CFrame)
        end

        -- 3. Picu TouchInterest di semua part karakter (agar sensor sentuh 2D langsung merespons)
        if firetouchinterest then
            firetouchinterest(rootPart, part, 0)
            firetouchinterest(rootPart, part, 1)
            if myCharModel then
                for _, charPart in ipairs(myCharModel:GetDescendants()) do
                    if charPart:IsA("BasePart") then
                        firetouchinterest(charPart, part, 0)
                        firetouchinterest(charPart, part, 1)
                    end
                end
            end
        end

        -- 4. Jika menggunakan Optional Collect Remote
        if activeCollectRemoteName ~= "" then
            local ColEvent = ReplicatedStorage:FindFirstChild(activeCollectRemoteName, true)
            if ColEvent and ColEvent:IsA("RemoteEvent") then
                if activeCollectBuf then
                    ColEvent:FireServer(activeCollectBuf, nil)
                else
                    ColEvent:FireServer(part)
                end
            end
        end
    end)
end

local function toggleCollect()
    isCollecting = not isCollecting
    updateStatusDisplay()

    if isCollecting then
        collectButton.Text = "Auto Collect Drop: ON"
        collectButton.BackgroundColor3 = Color3.fromRGB(215, 65, 65)
        collectBtnStroke.Color = Color3.fromRGB(255, 130, 130)

        task.spawn(function()
            local overlapParams = OverlapParams.new()
            overlapParams.FilterType = Enum.RaycastFilterType.Exclude

            while isCollecting do
                local radius = tonumber(collectRadiusInput.Text) or 25
                local scanSpd = tonumber(collectSpeedInput.Text) or 0.05
                if radius < 1 then radius = 1 end
                if scanSpd < 0.01 then scanSpd = 0.01 end

                local rootPart, myCharModel = findPlayerRootAndModel()

                if rootPart then
                    if myCharModel then
                        overlapParams.FilterDescendantsInstances = { myCharModel }
                    else
                        overlapParams.FilterDescendantsInstances = { rootPart }
                    end

                    local nearbyParts = workspace:GetPartBoundsInRadius(rootPart.Position, radius, overlapParams)
                    local collectedCount = 0
                    local nearestDropXDelta = nil
                    local minAbsX = math.huge

                    for _, part in ipairs(nearbyParts) do
                        if not isCollecting then break end
                        if isLikelyDroppedItem(part, myCharModel) then
                            local dx = part.Position.X - rootPart.Position.X
                            if math.abs(dx) > 0.6 and math.abs(dx) < minAbsX then
                                minAbsX = math.abs(dx)
                                nearestDropXDelta = dx
                            end

                            collectSingleItem(part, rootPart, myCharModel)
                            collectedCount = collectedCount + 1
                        end
                    end

                    -- Jika game mengecek posisi fisik server untuk klaim drop di sebelah kanan/kiri (ketika sedang tidak spam atau jeda):
                    if nearestDropXDelta and not isCurrentlyMoving then
                        local oldCF = rootPart.CFrame
                        -- Micro-step CFrame ke titik item lalu kembali agar server mendeteksi posisi pengambilan
                        pcall(function()
                            rootPart.CFrame = oldCF + Vector3.new(math.clamp(nearestDropXDelta, -radius, radius), 0, 0)
                            task.wait(0.02)
                            rootPart.CFrame = oldCF
                        end)
                    end

                    if collectedCount > 0 then
                        collectStatusLabel.Text = 'Collect Status: <font color="#65e874">Claiming ' .. collectedCount .. ' drop(s) in ' .. radius .. ' studs!</font>'
                    else
                        collectStatusLabel.Text = 'Collect Status: <font color="#65e874">Scanning [' .. rootPart.Name .. '] (' .. radius .. ' Studs)...</font>'
                    end
                else
                    collectStatusLabel.Text = 'Collect Status: <font color="#ffdf55">Searching 2D Character...</font>'
                end

                task.wait(scanSpd)
            end

            local r = tonumber(collectRadiusInput.Text) or 25
            collectStatusLabel.Text = 'Collect Status: <font color="#a0d8ef">Idle (Radius: ' .. r .. ' Studs)</font>'
        end)
    else
        collectButton.Text = "Auto Collect Drop: OFF"
        collectButton.BackgroundColor3 = Color3.fromRGB(85, 195, 95)
        collectBtnStroke.Color = Color3.fromRGB(145, 235, 155)
        local r = tonumber(collectRadiusInput.Text) or 25
        collectStatusLabel.Text = 'Collect Status: <font color="#a0d8ef">Idle (Radius: ' .. r .. ' Studs)</font>'
    end
end

local function toggleSpam()
    isSpamming = not isSpamming
    isCurrentlyMoving = false
    updateStatusDisplay()

    if isSpamming then
        runButton.Text = "Start Spam: ON"
        runButton.BackgroundColor3 = Color3.fromRGB(215, 65, 65)
        buttonStroke.Color = Color3.fromRGB(255, 130, 130)

        task.spawn(function()
            local cycleStartTime = os.clock()

            while isSpamming do
                local Event = ReplicatedStorage:FindFirstChild(activeRemoteName)
                if not Event then
                    cycleStatusLabel.Text = 'Cycle Status: <font color="#ff6b6b">Remote [' .. activeRemoteName .. '] Not Found!</font>'
                    task.wait(0.5)
                    continue
                end

                local dur1 = tonumber(duration1Input.Text) or 0
                local dur2 = tonumber(duration2Input.Text) or 0
                local spd = tonumber(speedInput.Text) or 0.03
                local maxCycleTime = tonumber(pauseCycleInput.Text) or 60

                if dur1 < 0 then dur1 = 0 end
                if dur2 < 0 then dur2 = 0 end
                if spd < 0.01 then spd = 0.01 end

                -- Cek Move Cycle jika fitur Auto Move Cycle sedang ON
                if appData.moveCycleEnabled and maxCycleTime > 0 then
                    local elapsedCycle = os.clock() - cycleStartTime
                    if elapsedCycle >= maxCycleTime then
                        executeMoveBreakSequence()
                        cycleStartTime = os.clock()
                        if not isSpamming then break end
                    else
                        local remain = math.max(0, math.ceil(maxCycleTime - elapsedCycle))
                        cycleStatusLabel.Text = 'Cycle Status: <font color="#65e874">Move ON (' .. remain .. 's left)</font>'
                    end
                else
                    cycleStatusLabel.Text = 'Cycle Status: <font color="#a0d8ef">Move Cycle OFF (Continuous)</font>'
                end

                -- STAGE 1: Execute Script 1
                if activeBuf1 then
                    Event:FireServer(activeBuf1, nil)
                end

                -- Cek apakah Script 2 diaktifkan dan memiliki buffer
                if activeUseScript2 and activeBuf2 then
                    if dur1 > 0 then
                        task.wait(dur1)
                    else
                        task.wait(spd)
                    end

                    if not isSpamming then break end

                    -- STAGE 2: Spam Script 2 continuously for dur2 seconds
                    local startTime2 = os.clock()
                    repeat
                        Event:FireServer(activeBuf2, nil)
                        task.wait(spd)

                        if appData.moveCycleEnabled and maxCycleTime > 0 and (os.clock() - cycleStartTime) >= maxCycleTime then
                            break
                        end
                    until (os.clock() - startTime2) >= dur2 or not isSpamming
                else
                    -- MODE KHUSUS SCRIPT 1 SAJA
                    local waitTimeS1Only = (dur1 > 0) and dur1 or spd
                    task.wait(waitTimeS1Only)
                end
            end

            cycleStatusLabel.Text = 'Cycle Status: <font color="#a0d8ef">Idle</font>'
        end)
    else
        runButton.Text = "Start Spam: OFF"
        runButton.BackgroundColor3 = Color3.fromRGB(85, 195, 95)
        buttonStroke.Color = Color3.fromRGB(145, 235, 155)
        cycleStatusLabel.Text = 'Cycle Status: <font color="#a0d8ef">Idle</font>'
    end
end

local function toggleDrop()
    isDropping = not isDropping
    updateStatusDisplay()

    if isDropping then
        dropButton.Text = "Auto Drop (2x): ON"
        dropButton.BackgroundColor3 = Color3.fromRGB(215, 65, 65)
        dropBtnStroke2.Color = Color3.fromRGB(255, 130, 130)

        task.spawn(function()
            while isDropping do
                local dDelay = tonumber(dropDelayInput.Text) or 5
                if dDelay < 0.05 then dDelay = 0.05 end

                local DropEvent = ReplicatedStorage:FindFirstChild(activeDropRemoteName)
                if DropEvent and activeDropBuf then
                    -- Eksekusi 2x setiap kali siklus Drop berjalan
                    for i = 1, 2 do
                        if not isDropping then break end
                        DropEvent:FireServer(activeDropBuf, nil)
                        if i == 1 then
                            task.wait(0.05)
                        end
                    end
                    dropStatusLabel.Text = 'Drop Status: <font color="#65e874">Fired 2x! Next in ' .. dDelay .. 's</font>'
                else
                    dropStatusLabel.Text = 'Drop Status: <font color="#ff6b6b">Remote [' .. activeDropRemoteName .. '] Not Found!</font>'
                end

                local startWait = os.clock()
                while isDropping and (os.clock() - startWait) < dDelay do
                    local left = math.max(0, math.ceil(dDelay - (os.clock() - startWait)))
                    if DropEvent then
                        dropStatusLabel.Text = 'Drop Status: <font color="#65e874">Active 2x (Next drop in ' .. left .. 's)</font>'
                    end
                    task.wait(0.1)
                end
            end
            dropStatusLabel.Text = 'Drop Status: <font color="#a0d8ef">Idle (2x Every 5s)</font>'
        end)
    else
        dropButton.Text = "Auto Drop (2x): OFF"
        dropButton.BackgroundColor3 = Color3.fromRGB(85, 195, 95)
        dropBtnStroke2.Color = Color3.fromRGB(145, 235, 155)
        dropStatusLabel.Text = 'Drop Status: <font color="#a0d8ef">Idle (2x Every 5s)</font>'
    end
end

