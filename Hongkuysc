local function khSafeUpvalues(fn)
	if type(fn) ~= "function" then return {} end
	if debug and debug.getupvalues then
		local ok, ups = pcall(debug.getupvalues, fn)
		if ok and type(ups) == "table" then return ups end
	end
	return {}
end

local function khIsStateHolder(v)
	if type(v) ~= "table" then return false end
	local fn = rawget(v, "state")
	if type(fn) ~= "function" then return false end
	local ok, s = pcall(fn)
	return ok and type(s) == "table" and type(s.x) == "number" and type(s.y) == "number"
		and s.facing ~= nil and s.vx ~= nil
end

local function khIsDropList(t)
	if type(t) ~= "table" or t == KH_Refs.World then return false end
	local first = rawget(t, 1)
	if first == nil then return next(t) == nil end
	return type(first) == "table" and rawget(first, "uid") ~= nil and rawget(first, "frame") ~= nil
end

local function khFindDropUpdate()
	local w, list = KH_Refs.World, KH_Drops.list
	local wd = w and rawget(w, "dropTaken")
	if type(wd) ~= "function" or not list then return false end
	for _, u in pairs(khSafeUpvalues(wd)) do
		if type(u) == "function" then
			for _, uu in pairs(khSafeUpvalues(u)) do
				if rawequal(uu, list) then
					KH_Drops.update = u
					return true
				end
			end
		end
	end
	return false
end

local function khFindDropRefs(deep)
	local w0 = KH_Refs.World
	local dl = w0 and rawget(w0, "dropList")
	if type(dl) == "function" then
		local okl, l = pcall(dl)
		if okl and khIsDropList(l) then
			if KH_Drops.list ~= l then KH_Drops.update = nil end
			KH_Drops.list = l
			if not KH_Drops.update then khFindDropUpdate() end
			return true
		end
	end
	if KH_Drops.list and not deep then return true end
	KH_Drops.list, KH_Drops.update = nil, nil

	local wd = KH_Refs.World and rawget(KH_Refs.World, "dropTaken")
	if type(wd) == "function" then
		for _, u in pairs(khSafeUpvalues(wd)) do
			if not KH_Drops.list and khIsDropList(u) then
				KH_Drops.list = u
			elseif not KH_Drops.update and type(u) == "function" then
				KH_Drops.update = u
			end
		end
	end

	local WorldRemotes = ReplicatedStorage:FindFirstChild("WorldRemotes")
	local ev = WorldRemotes and WorldRemotes:FindFirstChild("DropTaken")
	if not KH_Drops.list and ev and getconnections then
		local ok, conns = pcall(getconnections, ev.OnClientEvent)
		if ok and type(conns) == "table" then
			for _, c in ipairs(conns) do
				local okf, fn = pcall(function() return c.Function end)
				if okf and type(fn) == "function" then
					for _, u in pairs(khSafeUpvalues(fn)) do
						if not KH_Drops.list and khIsDropList(u) then
							KH_Drops.list = u
						elseif not KH_Drops.update and type(u) == "function" then
							KH_Drops.update = u
						end
					end
				end
				if KH_Drops.list then break end
			end
		end
	end

	if not KH_Drops.list and deep and getgc then
		local okGc, gcList = pcall(getgc, true)
		if okGc and type(gcList) == "table" then
			for _, v in ipairs(gcList) do
				if type(v) == "table" then
					local e = rawget(v, 1)
					if type(e) == "table" and rawget(e, "uid") ~= nil and rawget(e, "frame") ~= nil
						and rawget(e, "born") ~= nil then
						KH_Drops.list = v
						break
					end
				end
			end
		end
	end

	return KH_Drops.list ~= nil
end

local function khScanRefs(force)
	local now = os.clock()
	if not force and (now - KH_Refs.LastScan) < 1.0 and KH_Refs.World then
		khFindDropRefs(false)
		return true
	end
	KH_Refs.LastScan = now

	if getgc then
		local okGc, gcList = pcall(getgc, true)
		if okGc and type(gcList) == "table" then
			for _, v in ipairs(gcList) do
				if type(v) == "table" then
					if not KH_Refs.World then
						local ok, isWorld = pcall(function()
							return type(rawget(v, "fg")) == "table" and type(rawget(v, "bg")) == "table"
								and type(rawget(v, "w")) == "number" and type(rawget(v, "h")) == "number"
								and rawget(v, "spawn") ~= nil
						end)
						if ok and isWorld then KH_Refs.World = v end
					end
					if not KH_Refs.Inv then
						local ok, isInv = pcall(function()
							return type(rawget(v, "slots")) == "table" and type(rawget(v, "count")) == "function"
						end)
						if ok and isInv then KH_Refs.Inv = v end
					end
					if not KH_Refs.State then
						local ok, isHolder = pcall(khIsStateHolder, v)
						if ok and isHolder then KH_Refs.State = rawget(v, "state") end
					end
				end
				if KH_Refs.World and KH_Refs.Inv and KH_Refs.State then
					break
				end
			end
		end
	end

	pcall(khFindDropRefs, true)
	return KH_Drops.list ~= nil
end

local function khGetPlayerCoord()
	if KH_Refs.State then
		local ok, s = pcall(KH_Refs.State)
		if ok and type(s) == "table" and type(s.x) == "number" and type(s.y) == "number" and s.active ~= false then
			return s.x, s.y - 0.475
		end
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		return root.Position.X / 4.5, root.Position.Y / 4.5
	end
	return nil, nil
end

local function khApplyTaken(d, left)
	local list = KH_Drops.list
	if not list or not table.find(list, d) then return end
	if not KH_Drops.update then khFindDropUpdate() end
	if KH_Drops.update and pcall(KH_Drops.update, d, left) then
		if left > 0 then
			d.flown = nil
			if typeof(d.frame) == "Instance" then
				pcall(function() d.frame.Visible = not d.culled end)
			end
		end
		return
	end
	d.n = left
	if left > 0 then
		d.flown = nil
		if typeof(d.frame) == "Instance" then
			pcall(function() d.frame.Visible = not d.culled end)
		end
	else
		local idx = table.find(list, d)
		if idx then table.remove(list, idx) end
		if typeof(d.frame) == "Instance" then
			pcall(function() d.frame:Destroy() end)
		end
	end
end

local function khTakeDrop(d)
	local WorldRemotes = ReplicatedStorage:FindFirstChild("WorldRemotes")
	local TakeDropRemote = WorldRemotes and WorldRemotes:FindFirstChild("TakeDrop")
	local worldTake = KH_Refs.World and rawget(KH_Refs.World, "takeDrop")
	if type(worldTake) ~= "function" and not TakeDropRemote then return 0 end
	if type(d) ~= "table" or d.taking or d.pending or d.display or (d.n or 0) <= 0 then
		return 0
	end
	if d.armed == false and d.id ~= 112 then return 0 end

	local now = os.clock()
	if KH_DropFailUntil[d.uid] and now < KH_DropFailUntil[d.uid] then return 0 end

	local amount = d.n
	if d.id ~= 112 and KH_Refs.Inv then
		local okr, room = pcall(function() return KH_Refs.Inv:room(d.id) end)
		if okr and type(room) == "number" then
			amount = math.min(amount, room)
		end
	end
	if amount <= 0 then
		KH_DropFailUntil[d.uid] = now + 1
		return 0
	end

	d.taking = true
	if typeof(d.frame) == "Instance" then
		pcall(function() d.frame.Visible = false end)
	end

	local ok, taken
	if type(worldTake) == "function" then
		ok, taken = pcall(worldTake, d.uid, amount)
	else
		ok, taken = pcall(TakeDropRemote.InvokeServer, TakeDropRemote, d.uid, amount)
	end
	d.taking = false

	if not (ok and type(taken) == "number" and taken > 0) then
		d.failN = (d.failN or 0) + 1
		KH_DropFailUntil[d.uid] = os.clock() + math.min(6, d.failN)
		if typeof(d.frame) == "Instance" then
			pcall(function() d.frame.Visible = not d.culled end)
		end
		return 0
	end

	KH_DropFailUntil[d.uid] = nil
	if KH_Refs.Inv and d.id ~= 112 then
		pcall(function() KH_Refs.Inv:add(d.id, taken) end)
	end
	khApplyTaken(d, math.max(0, (d.n or 0) - taken))
	return taken
end

local function khCollectPass()
	local takenTotal = 0
	local now = os.clock()
	local cx, cy = khGetPlayerCoord()
	local radius = tonumber(appData.collectRadius) or 6

	if type(KH_Drops.list) == "table" and cx and cy then
		for i = #KH_Drops.list, 1, -1 do
			local d = KH_Drops.list[i]
			if type(d) == "table" and type(d.x) == "number" and type(d.y) == "number" and (d.n or 0) > 0 and not d.taking then
				if d.armed ~= false or d.id == 112 then
					if not (KH_DropFailUntil[d.uid] and now < KH_DropFailUntil[d.uid]) then
						if math.abs(d.x - cx) <= radius and math.abs(d.y - cy) <= radius then
							takenTotal += khTakeDrop(d)
						end
					end
				end
			end
		end
	end

	return takenTotal
end

-- ==========================================
-- 9. MAIN SPAM LOOP, AUTO-MOVE, AUTO DROP (2x) & KIAN HUB AUTO COLLECT (2x)
-- ==========================================
local isSpamming = false
local isDropping = false
local isCollecting = false
local isCurrentlyMoving = false

local lastPunchTime = 0
local function registerBlockPunch()
	lastPunchTime = os.clock()
	pcall(khScanRefs, false)
end

local function isPostPunchActive()
	local window = tonumber(appData.postPunchWindow) or 4.0
	if lastPunchTime <= 0 then return false end
	return (os.clock() - lastPunchTime) <= window
end

local function updateStatusDisplay()
	local spamStr
	if isCurrentlyMoving then
		spamStr = '<font color="#ffdf55">MOVING</font>'
	else
		spamStr = isSpamming and '<font color="#65e874">ON</font>' or '<font color="#ff6b6b">OFF</font>'
	end
	local dropStr = isDropping and '<font color="#65e874">ON</font>' or '<font color="#ff6b6b">OFF</font>'
	local collectStr = isCollecting and '<font color="#65e874">ON</font>' or '<font color="#ff6b6b">OFF</font>'
	statusTopRight.Text = "Spam: " .. spamStr .. " | Drop: " .. dropStr .. " | Collect: " .. collectStr
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
		or input.KeyCode == Enum.KeyCode.F
		or input.KeyCode == Enum.KeyCode.E
	then
		registerBlockPunch()
	end
end)

local function interruptibleWait(seconds)
	local startWait = os.clock()
	while isSpamming and (os.clock() - startWait) < seconds do
		task.wait(0.05)
	end
end

local function executeMoveBreakSequence()
	local holdATime  = tonumber(holdAInput.Text) or 0.3
	local waitAfterA = tonumber(waitAfterAInput.Text) or 2
	local holdWTime  = tonumber(holdWInput.Text) or 0.3
	local holdDTime  = tonumber(holdDInput.Text) or 0.3

	if holdATime < 0.01 then holdATime = 0.01 end
	if waitAfterA < 0 then waitAfterA = 0 end
	if holdWTime < 0.01 then holdWTime = 0.01 end
	if holdDTime < 0.01 then holdDTime = 0.01 end

	isCurrentlyMoving = true
	updateStatusDisplay()

	cycleStatusLabel.Text = 'Cycle Status: <font color="#ffdf55">1. Holding [A] (' .. holdATime .. 's)...</font>'
	pressAndHoldKey(Enum.KeyCode.A, holdATime)
	if not isSpamming then isCurrentlyMoving = false; updateStatusDisplay(); return end

	if waitAfterA > 0 then
		cycleStatusLabel.Text = 'Cycle Status: <font color="#ffdf55">2. Waiting (' .. waitAfterA .. 's)...</font>'
		interruptibleWait(waitAfterA)
		if not isSpamming then isCurrentlyMoving = false; updateStatusDisplay(); return end
	end

	cycleStatusLabel.Text = 'Cycle Status: <font color="#ffdf55">3. Holding [W] (' .. holdWTime .. 's)...</font>'
	pressAndHoldKey(Enum.KeyCode.W, holdWTime)
	if not isSpamming then isCurrentlyMoving = false; updateStatusDisplay(); return end

	cycleStatusLabel.Text = 'Cycle Status: <font color="#ffdf55">4. Holding [D] (' .. holdDTime .. 's)...</font>'
	pressAndHoldKey(Enum.KeyCode.D, holdDTime)

	isCurrentlyMoving = false
	updateStatusDisplay()
end

local function toggleSpam()
	isSpamming = not isSpamming
	isCurrentlyMoving = false
	updateStatusDisplay()

	if isSpamming then
		runButton.Text = "Start Spam: ON"
		runButton.BackgroundColor3 = Color3.fromRGB(215, 65, 65)
		buttonStroke.Color = Color3.fromRGB(255, 130, 130)

		task.spawn(function()
			local cycleStartTime = os.clock()

			while isSpamming do
				local Event = ReplicatedStorage:FindFirstChild(activeRemoteName)
				if not Event then
					cycleStatusLabel.Text = 'Cycle Status: <font color="#ff6b6b">Remote [' .. activeRemoteName .. '] Not Found!</font>'
					task.wait(0.5)
					continue
				end

				local dur1 = tonumber(duration1Input.Text) or 0
				local dur2 = tonumber(duration2Input.Text) or 0
				local spd = tonumber(speedInput.Text) or 0.03
				local maxCycleTime = tonumber(pauseCycleInput.Text) or 60

				if dur1 < 0 then dur1 = 0 end
				if dur2 < 0 then dur2 = 0 end
				if spd < 0.01 then spd = 0.01 end

				if appData.moveCycleEnabled and maxCycleTime > 0 then
					local elapsedCycle = os.clock() - cycleStartTime
					if elapsedCycle >= maxCycleTime then
						executeMoveBreakSequence()
						cycleStartTime = os.clock()
						if not isSpamming then break end
					else
						local remain = math.max(0, math.ceil(maxCycleTime - elapsedCycle))
						cycleStatusLabel.Text = 'Cycle Status: <font color="#65e874">Move ON (' .. remain .. 's left)</font>'
					end
				else
					cycleStatusLabel.Text = 'Cycle Status: <font color="#a0d8ef">Move Cycle OFF (Continuous)</font>'
				end

				if activeBuf1 then
					Event:FireServer(activeBuf1, nil)
					registerBlockPunch()
				end

				if activeUseScript2 and activeBuf2 then
					if dur1 > 0 then
						task.wait(dur1)
					else
						task.wait(spd)
					end

					if not isSpamming then break end

					local startTime2 = os.clock()
					repeat
						Event:FireServer(activeBuf2, nil)
						registerBlockPunch()
						task.wait(spd)

						if appData.moveCycleEnabled and maxCycleTime > 0 and (os.clock() - cycleStartTime) >= maxCycleTime then
							break
						end
					until (os.clock() - startTime2) >= dur2 or not isSpamming
				else
					local waitTimeS1Only = (dur1 > 0) and dur1 or spd
					task.wait(waitTimeS1Only)
				end
			end

			cycleStatusLabel.Text = 'Cycle Status: <font color="#a0d8ef">Idle</font>'
		end)
	else
		runButton.Text = "Start Spam: OFF"
		runButton.BackgroundColor3 = Color3.fromRGB(85, 195, 95)
		buttonStroke.Color = Color3.fromRGB(145, 235, 155)
		cycleStatusLabel.Text = 'Cycle Status: <font color="#a0d8ef">Idle</font>'
	end
end

local function toggleDrop()
	isDropping = not isDropping
	updateStatusDisplay()

	if isDropping then
		dropButton.Text = "Auto Drop (2x): ON"
		dropButton.BackgroundColor3 = Color3.fromRGB(215, 65, 65)
		dropBtnStroke2.Color = Color3.fromRGB(255, 130, 130)

		task.spawn(function()
			while isDropping do
				local dDelay = tonumber(dropDelayInput.Text) or 5
				if dDelay < 0.05 then dDelay = 0.05 end

				local DropEvent = ReplicatedStorage:FindFirstChild(activeDropRemoteName)
				if DropEvent and activeDropBuf then
					for i = 1, 2 do
						if not isDropping then break end
						DropEvent:FireServer(activeDropBuf, nil)
						if i == 1 then
							task.wait(0.05)
						end
					end
					dropStatusLabel.Text = 'Drop Status: <font color="#65e874">Fired 2x! Next in ' .. dDelay .. 's</font>'
				else
					dropStatusLabel.Text = 'Drop Status: <font color="#ff6b6b">Remote [' .. activeDropRemoteName .. '] Not Found!</font>'
				end

				local startWait = os.clock()
				while isDropping and (os.clock() - startWait) < dDelay do
					local left = math.max(0, math.ceil(dDelay - (os.clock() - startWait)))
					if DropEvent then
						dropStatusLabel.Text = 'Drop Status: <font color="#65e874">Active 2x (Next drop in ' .. left .. 's)</font>'
					end
					task.wait(0.1)
				end
			end
			dropStatusLabel.Text = 'Drop Status: <font color="#a0d8ef">Idle (2x Every 5s)</font>'
		end)
	else
		dropButton.Text = "Auto Drop (2x): OFF"
		dropButton.BackgroundColor3 = Color3.fromRGB(85, 195, 95)
		dropBtnStroke2.Color = Color3.fromRGB(145, 235, 155)
		dropStatusLabel.Text = 'Drop Status: <font color="#a0d8ef">Idle (2x Every 5s)</font>'
	end
end

local function toggleCollect()
	isCollecting = not isCollecting
	updateStatusDisplay()

	if isCollecting then
		pcall(khScanRefs, true)
		collectButton.Text = "Auto Collect (2x): ON"
		collectButton.BackgroundColor3 = Color3.fromRGB(215, 65, 65)
		collectBtnStroke.Color = Color3.fromRGB(255, 130, 130)

		task.spawn(function()
			local totalTakenAll = 0
			while isCollecting do
				local cDelay = tonumber(collectDelayInput.Text) or 0.25
				if cDelay < 0.05 then cDelay = 0.05 end

				if isPostPunchActive() then
					pcall(khScanRefs, false)
					local cycleTaken = 0
					for runIdx = 1, 2 do
						if not isCollecting then break end
						collectStatusLabel.Text = 'Collect Status: <font color="#ffdf55">Kian Hub 2x Run (' .. runIdx .. '/2)</font>'
						cycleTaken += khCollectPass()
						if runIdx == 1 and isCollecting then
							task.wait(0.05)
						end
					end
					totalTakenAll += cycleTaken
					collectStatusLabel.Text = 'Collect Status: <font color="#65e874">2x Done | Taken: ' .. totalTakenAll .. '</font>'
				else
					collectStatusLabel.Text = 'Collect Status: <font color="#a0d8ef">Punch Block to Collect (Gems/Seed)</font>'
				end

				local startWait = os.clock()
				while isCollecting and (os.clock() - startWait) < cDelay do
					task.wait(0.05)
				end
			end
			collectStatusLabel.Text = 'Collect Status: <font color="#a0d8ef">Idle (Kian Hub 2x Run)</font>'
		end)
	else
		collectButton.Text = "Auto Collect (2x): OFF"
		collectButton.BackgroundColor3 = Color3.fromRGB(85, 195, 95)
		collectBtnStroke.Color = Color3.fromRGB(145, 235, 155)
		collectStatusLabel.Text = 'Collect Status: <font color="#a0d8ef">Idle (Kian Hub 2x Run)</font>'
	end
end

runButton.MouseButton1Click:Connect(toggleSpam)
dropButton.MouseButton1Click:Connect(toggleDrop)
