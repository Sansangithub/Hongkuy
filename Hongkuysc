local lastCmdTime = 0

local function applyGameName(newName, showNotif)
    local targetPlayer = Players:FindFirstChild(player.Name)
    if targetPlayer then
        targetPlayer:SetAttribute("GameName", newName)
        if targetPlayer.Character then
            targetPlayer.Character:SetAttribute("GameName", newName)
        end
        if showNotif then
            sendSystemNotification("HongKuy", 'GameName changed & saved: <font color="#55ffff">' .. newName .. '</font>', false)
        end
    end
end

