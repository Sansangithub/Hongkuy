local function executeChangeName(newName)
    if os.clock() - lastCmdTime < 0.15 then return end
    lastCmdTime = os.clock()

    appData.customGameName = newName
    saveConfigData()
    applyGameName(newName, true)
end

local function checkAndRunCommands(text)
    if type(text) ~= "string" then return end
    local newName = string.match(text, "^%s*/[nN]%s+(.+)")
    if newName then
        newName = string.gsub(newName, "^%s*(.-)%s*$", "%1")
        if newName ~= "" then
            executeChangeName(newName)
        end
    end
end

