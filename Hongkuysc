-- 9. AUTO TAKE BUFFER LOOP (PER INSTANCE)
-- ==========================================
local isTaking = false
local totalFiredCycles = 0

local function toggleTake()
	if not screenGui or not screenGui.Parent then return end
	isTaking = not isTaking

	if isTaking then
		statusTopRight.Text = 'Take: <font color="#65e874">ON</font>'
		takeButton.Text = "Auto Take: ON"
		takeButton.BackgroundColor3 = Color3.fromRGB(215, 65, 65)
		takeBtnStroke.Color = Color3.fromRGB(255, 130, 130)

		task.spawn(function()
			while isTaking and screenGui and screenGui.Parent do
				local dDelay = math.max(0.01, tonumber(activeConfig.takeDelay) or 0.25)
				local runs = math.max(1, math.floor(tonumber(activeConfig.runCount) or 2))
				local bDelay = math.max(0, tonumber(activeConfig.multiBufDelay) or 0.05)

				local TakeEvent = ReplicatedStorage:FindFirstChild(activeConfig.remote)
				if TakeEvent and activeTakeBuf then
					for r = 1, runs do
						if not isTaking then break end
						TakeEvent:FireServer(activeTakeBuf, nil)
						if r < runs and isTaking and bDelay > 0 then
							task.wait(bDelay)
						end
					end
					totalFiredCycles += 1
					takeStatusLabel.Text = 'Take Status: <font color="#65e874">Fired ' .. tostring(runs) .. 'x | Cycles: ' .. tostring(totalFiredCycles) .. '</font>'
				elseif not TakeEvent then
					takeStatusLabel.Text = 'Take Status: <font color="#ff6b6b">Remote [' .. tostring(activeConfig.remote) .. '] Not Found!</font>'
				else
					takeStatusLabel.Text = 'Take Status: <font color="#ff6b6b">Buffer Empty / Invalid Bytes!</font>'
				end

				local startWait = os.clock()
				while isTaking and (os.clock() - startWait) < dDelay do
					task.wait(0.02)
				end
			end

			if takeStatusLabel and takeStatusLabel.Parent then
				takeStatusLabel.Text = 'Take Status: <font color="#a0d8ef">Idle (Cycles: ' .. tostring(totalFiredCycles) .. ')</font>'
			end
		end)
	else
		statusTopRight.Text = 'Take: <font color="#ff6b6b">OFF</font>'
		takeButton.Text = "Auto Take: OFF"
		takeButton.BackgroundColor3 = Color3.fromRGB(85, 195, 95)
		takeBtnStroke.Color = Color3.fromRGB(145, 235, 155)
		takeStatusLabel.Text = 'Take Status: <font color="#a0d8ef">Idle (Cycles: ' .. tostring(totalFiredCycles) .. ')</font>'
	end
end

takeButton.MouseButton1Click:Connect(toggleTake)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not screenGui or not screenGui.Parent then return end

	if isBindingKey then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
				currentKeybind = nil
				keybindBtn.Text = "Key: [None]"
			else
				currentKeybind = input.KeyCode
				keybindBtn.Text = "Key: [" .. input.KeyCode.Name .. "]"
			end
			keybindBtn.BackgroundColor3 = Color3.fromRGB(20, 52, 60)
			isBindingKey = false
		end
		return
	end

	if not gameProcessed and currentKeybind and input.KeyCode == currentKeybind then
		toggleTake()
	end
end)
