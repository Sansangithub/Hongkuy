local function tryExtractRemoteFromPaste(text, targetBox)
    local rem = string.match(text, 'ReplicatedStorage"%s*%)%.([%w_]+)') or string.match(text, 'ReplicatedStorage%.([%w_]+)')
    if rem and rem ~= "" then
        targetBox.Text = rem
    end
end

