		selectedPreset = 1,
		presets = {
			{
				name = "Default Take Buffer",
				remote = defaultTakeRemote,
				bufStr = defaultTakeBytes,
				takeDelay = "0.25",
				runCount = "2",
				multiBufDelay = "0.05"
			}
		}
	}
end

local appData = getDefaultData()

local function saveConfigData()
	pcall(function()
		if writefile then
			local json = HttpService:JSONEncode(appData)
			writefile(CONFIG_FILE, json)
		end
	end)
end

local function loadConfigData()
	local loaded = false
	pcall(function()
		if isfile and readfile and isfile(CONFIG_FILE) then
			local raw = readfile(CONFIG_FILE)
			local decoded = HttpService:JSONDecode(raw)
			if type(decoded) == "table" and type(decoded.presets) == "table" and #decoded.presets > 0 then
				for k, v in pairs(decoded) do
					appData[k] = v
				end
				for _, p in ipairs(appData.presets) do
					p.name = tostring(p.name or "Custom Take")
					p.remote = tostring(p.remote or defaultTakeRemote)
					p.bufStr = tostring(p.bufStr or defaultTakeBytes)
					p.takeDelay = tostring(p.takeDelay or "0.25")
					p.runCount = tostring(p.runCount or "2")
					p.multiBufDelay = tostring(p.multiBufDelay or "0.05")
				end
				if not appData.presets[appData.selectedPreset] then
					appData.selectedPreset = 1
				end
				loaded = true
			end
		end
	end)
	return loaded
end

