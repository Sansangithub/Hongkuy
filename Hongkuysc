-- Klik Save / Update Current Preset, Slot, Drop & Collect
saveCurrentPresetBtn.MouseButton1Click:Connect(function()
    local preset = appData.presets[appData.selectedPreset]
    if not preset then return end

    local newName = string.gsub(presetNameBox.Text, "^%s*(.-)%s*$", "%1")
    local newRemote = string.gsub(remoteNameBox.Text, "^%s*(.-)%s*$", "%1")
    local newDropRem = string.gsub(dropRemoteBox.Text, "^%s*(.-)%s*$", "%1")
    local newColRem = string.gsub(collectRemoteBox.Text, "^%s*(.-)%s*$", "%1")
    if newName == "" then newName = "Custom Preset" end
    if newRemote == "" then newRemote = "RI3aUNDuH2" end
    if newDropRem == "" then newDropRem = "wDXRlfJPK1" end

    local cleanS1 = normalizeByteString(buf1Box.Text)
    local cleanS2 = normalizeByteString(buf2Box.Text)
    local cleanDrop = normalizeByteString(dropBufBox.Text)
    local cleanCol = normalizeByteString(collectBufBox.Text)

    preset.name = newName
    preset.remote = newRemote
    preset.useScript2 = settingUseS2 and (cleanS2 ~= "")
    preset.dur1 = duration1Input.Text
    preset.dur2 = duration2Input.Text
    preset.speed = speedInput.Text
    preset.bufDelay = bufDelayInput.Text
    preset.slots[appData.selectedSlot].s1 = cleanS1
    preset.slots[appData.selectedSlot].s2 = cleanS2

    appData.dropRemote = newDropRem
    appData.dropBufStr = cleanDrop
    appData.collectRemote = newColRem
    appData.collectBufStr = cleanCol

    syncAllUI()
    refreshDropdownUI()
    saveConfigData()

    local modeInfo = preset.useScript2 and "S1 + S2" or "Script 1 Only"
    sendSystemNotification("Settings Saved", 'Saved <font color="#65e874">' .. newName .. ' [Slot ' .. appData.selectedSlot .. ']</font> (' .. modeInfo .. '), Drop & Collect!', false)
end)

