local function sendSystemNotification(titleText, bodyText)
	notifToken += 1
	local currentToken = notifToken

	gtTitleLabel.Text = ">> " .. string.upper(titleText) .. " [#" .. instanceId .. "] <<"
	gtBodyLabel.Text = bodyText

	gtTitleLabel.TextTransparency = 0
	gtBodyLabel.TextTransparency = 0
	gtTitleStroke.Transparency = 0
	gtBodyStroke.Transparency = 0

	gtNotifHolder.Position = UDim2.new(0.5, 0, 0.17, 0)
	gtNotifHolder.Visible = true

	TweenService:Create(
		gtNotifHolder,
		TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Position = UDim2.new(0.5, 0, 0.20, 0) }
	):Play()

	task.delay(2.8, function()
		if notifToken ~= currentToken or not gtNotifHolder.Parent then return end
		local fadeInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(gtTitleLabel, fadeInfo, { TextTransparency = 1 }):Play()
		TweenService:Create(gtBodyLabel, fadeInfo, { TextTransparency = 1 }):Play()
		TweenService:Create(gtTitleStroke, fadeInfo, { Transparency = 1 }):Play()
		TweenService:Create(gtBodyStroke, fadeInfo, { Transparency = 1 }):Play()
		task.wait(0.4)
		if notifToken == currentToken and gtNotifHolder.Parent then
			gtNotifHolder.Visible = false
		end
	end)
end

-- ==========================================
-- DRAG FUNCTION (FOR PANELS & LOGO)
-- ==========================================
local function makeDraggable(guiObject)
	local dragging, dragInput, dragStart, startPos

	guiObject.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = guiObject.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	guiObject.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			guiObject.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

