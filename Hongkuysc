    rowStroke.Thickness = 1.2
    rowStroke.Parent = rowFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -150, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(240, 248, 255)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = rowFrame

    local minusBtn = Instance.new("TextButton")
    minusBtn.Size = UDim2.new(0, 24, 0, 20)
    minusBtn.Position = UDim2.new(1, -132, 0.5, -10)
    minusBtn.BackgroundColor3 = Color3.fromRGB(45, 92, 104)
    minusBtn.Text = "-"
    minusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    minusBtn.Font = Enum.Font.FredokaOne
    minusBtn.TextSize = 14
    minusBtn.Parent = rowFrame

    local minusCorner = Instance.new("UICorner")
    minusCorner.CornerRadius = UDim.new(0, 4)
    minusCorner.Parent = minusBtn

    local minusStroke = Instance.new("UIStroke")
    minusStroke.Color = Color3.fromRGB(105, 160, 175)
    minusStroke.Thickness = 1
    minusStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    minusStroke.Parent = minusBtn

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 64, 0, 20)
    box.Position = UDim2.new(1, -104, 0.5, -10)
    box.BackgroundColor3 = Color3.fromRGB(95, 118, 124)
    box.BorderSizePixel = 0
    box.Text = tostring(appData[configKey] or "0")
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 11
    box.ClearTextOnFocus = false
    box.Parent = rowFrame

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 4)
    boxCorner.Parent = box

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Color = Color3.fromRGB(140, 175, 185)
    boxStroke.Thickness = 1
    boxStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    boxStroke.Parent = box

    local plusBtn = Instance.new("TextButton")
    plusBtn.Size = UDim2.new(0, 24, 0, 20)
    plusBtn.Position = UDim2.new(1, -36, 0.5, -10)
    plusBtn.BackgroundColor3 = Color3.fromRGB(45, 92, 104)
    plusBtn.Text = "+"
    plusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    plusBtn.Font = Enum.Font.FredokaOne
    plusBtn.TextSize = 14
    plusBtn.Parent = rowFrame

    local plusCorner = Instance.new("UICorner")
    plusCorner.CornerRadius = UDim.new(0, 4)
    plusCorner.Parent = plusBtn

    local plusStroke = Instance.new("UIStroke")
    plusStroke.Color = Color3.fromRGB(105, 160, 175)
    plusStroke.Thickness = 1
    plusStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    plusStroke.Parent = plusBtn

    local function syncValue(newText)
        box.Text = newText
        appData[configKey] = newText
        if isPresetField then
            local p = appData.presets[appData.selectedPreset]
            if p then p[configKey] = newText end
        end
        saveConfigData()
    end

    minusBtn.MouseButton1Click:Connect(function()
        local current = tonumber(box.Text) or 0
        local nextVal = math.max(minValue, current - stepValue)
        syncValue(formatNumber(nextVal))
    end)

    plusBtn.MouseButton1Click:Connect(function()
        local current = tonumber(box.Text) or 0
        local nextVal = math.max(minValue, current + stepValue)
        syncValue(formatNumber(nextVal))
    end)

    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if not num then
            syncValue(tostring(appData[configKey] or minValue))
        else
            syncValue(formatNumber(math.max(minValue, num)))
        end
    end)

    return box
end

