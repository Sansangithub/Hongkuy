-- ==========================================
-- HELPER FUNCTIONS (BUFFER, KEYBOARD & CUSTOM 2D CHAR FINDER)
-- ==========================================
local function parseByteString(str)
    if type(str) ~= "string" then return {} end
    local braceContent = string.match(str, "{([%d%s,]+)}")
    local target = braceContent or str
    local bytes = {}
    for numStr in string.gmatch(target, "%d+") do
        local n = tonumber(numStr)
        if n and n >= 0 and n <= 255 then
            table.insert(bytes, n)
        end
    end
    return bytes
end

local function createBufferFromString(str)
    local bytes = parseByteString(str)
    if #bytes == 0 then
        return nil
    end
    local b = buffer.create(#bytes)
    for i = 1, #bytes do
        buffer.writeu8(b, i - 1, bytes[i])
    end
    return b
end

local function normalizeByteString(str)
    local bytes = parseByteString(str)
    return table.concat(bytes, ", ")
end

local function pressAndHoldKey(keyCode, holdDuration)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    end)
    if holdDuration and holdDuration > 0 then
        task.wait(holdDuration)
    end
    pcall(function()
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- Fungsi khusus untuk mencari BasePart utama karakter (mendukung Custom 2D Rig seperti di screenshot)
local function findPlayerRootAndModel()
    -- 1. Cek player.Character standar
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
            or char.PrimaryPart
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Hitbox")
            or char:FindFirstChild("Root")
            or char:FindFirstChildWhichIsA("BasePart", true)
        if root then
            return root, char
        end
    end

    -- 2. Cari di Workspace berdasarkan Nama / DisplayName / UserId (untuk game Custom 2D)
    local targetNames = {
        string.lower(player.Name),
        string.lower(player.DisplayName),
        tostring(player.UserId)
    }
    local customGameName = player:GetAttribute("GameName")
    if type(customGameName) == "string" and customGameName ~= "" then
        table.insert(targetNames, string.lower(customGameName))
    end

    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("Model") or desc:IsA("Folder") then
            local dName = string.lower(desc.Name)
            for _, tName in ipairs(targetNames) do
                if dName == tName then
                    local part = desc:FindFirstChild("HumanoidRootPart")
                        or (desc:IsA("Model") and desc.PrimaryPart)
                        or desc:FindFirstChild("Hitbox")
                        or desc:FindFirstChild("Torso")
                        or desc:FindFirstChildWhichIsA("BasePart", true)
                    if part then
                        return part, desc
                    end
                end
            end
        elseif desc:IsA("BasePart") then
            local dName = string.lower(desc.Name)
            for _, tName in ipairs(targetNames) do
                if dName == tName then
                    return desc, desc.Parent
                end
            end
        end
    end

    -- 3. Fallback terakhir: Gunakan CameraSubject jika kamera mengikuti objek pemain
    local cam = workspace.CurrentCamera
    if cam and cam.CameraSubject then
        local subj = cam.CameraSubject
        if subj:IsA("BasePart") then
            return subj, subj.Parent
        elseif subj:IsA("Humanoid") and subj.Parent then
            local p = subj.Parent:FindFirstChild("HumanoidRootPart") or subj.Parent:FindFirstChildWhichIsA("BasePart", true)
            if p then return p, subj.Parent end
        elseif subj:IsA("Model") then
            local p = subj.PrimaryPart or subj:FindFirstChildWhichIsA("BasePart", true)
            if p then return p, subj end
        end
    end

    return nil, nil
end

